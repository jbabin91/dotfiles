{
  "name": "dotfiles",
  "version": "1.0.0",
  "private": true,
  "description": "Personal dotfiles managed with Dotbot",
  "keywords": [
    "dotfiles"
  ],
  "license": "MIT",
  "author": "Jace Babin <jbabin91@gmail.com>",
  "type": "module",
  "scripts": {
    "format": "prettier --write '**/*.{json,yml,yaml,md}'",
    "format:check": "prettier --check '**/*.{json,yml,yaml,md}'",
    "lint": "pnpm run format:check && pnpm run lint:shell && pnpm run lint:zsh && pnpm run lint:md",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "lint:md:fix": "markdownlint-cli2 --fix '**/*.md'",
    "lint:shell": "git ls-files -z '*.sh' install | xargs -0 -r shellcheck",
    "lint:zsh": "git ls-files -z 'chezmoi/dot_z*' | xargs -0 -r -n1 zsh -n",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.4.2",
    "commitlint": "^20.4.2",
    "cz-git": "^1.12.0",
    "lefthook": "^2.1.1",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
