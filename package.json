{
  "name": "dotfiles",
  "version": "1.0.0",
  "private": true,
  "description": "Personal dotfiles managed with Dotbot",
  "keywords": [
    "dotfiles"
  ],
  "license": "MIT",
  "author": "Jace Babin <jbabin91@gmail.com>",
  "type": "module",
  "scripts": {
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,cjs,mjs,json,yml,yaml,md,mdx}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,cjs,mjs,json,yml,yaml,md,mdx}'",
    "lint": "pnpm run format:check && pnpm run lint:shell && pnpm run lint:zsh && pnpm run lint:md && pnpm run lint:actions",
    "lint:actions": "actionlint",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "lint:md:fix": "markdownlint-cli2 --fix '**/*.md'",
    "lint:shell": "git ls-files -z '*.sh' install | xargs -0 -r shellcheck",
    "lint:zsh": "git ls-files -z 'home/dot_z*' | xargs -0 -r -n1 zsh -n",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^22.20.3",
    "commitlint": "^21.2.2",
    "cz-git": "^1.14.0",
    "lefthook": "^2.1.14",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.4.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "warn"
    }
  }
}
