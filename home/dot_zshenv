# shellcheck shell=bash
# Environment (Sourced by ALL shells)
# Only put things here that are needed everywhere — interactive, non-interactive, git hooks

# -----------------------------------------------------------------------------
# Color Support (MUST be first - needed for all terminal applications)
# -----------------------------------------------------------------------------
export COLORTERM="${COLORTERM:-truecolor}"
export CLICOLOR=1

# Only default FORCE_COLOR on when stdout is a terminal. Forcing it everywhere
# makes chalk and supports-color write escapes into pipes, where the tool's own
# TTY detection would have kept them out. An explicit value always wins.
if [[ -n ${FORCE_COLOR+x} ]]; then
  export FORCE_COLOR
elif [[ -t 1 ]]; then
  export FORCE_COLOR=1
fi

# -----------------------------------------------------------------------------
# Homebrew (sets PREFIX, CELLAR, REPOSITORY, fpath, MANPATH, INFOPATH, PATH)
# -----------------------------------------------------------------------------
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
  export HOMEBREW_NO_ENV_HINTS=1
  # Ask mode is on by default in current Homebrew; this turns it back off.
  export HOMEBREW_NO_ASK=1
  # Without a terminal, keep read-only queries read-only: otherwise `brew
  # outdated` self-updates the taps mid-command. `bu` and `ud` still update.
  [[ -t 1 ]] || export HOMEBREW_NO_AUTO_UPDATE=1
  # Re-prepend after brew shellenv; path_helper can push /usr/bin ahead of Homebrew
  case "$PATH" in
    /opt/homebrew/bin:*) ;;
    *) export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH" ;;
  esac
fi

# -----------------------------------------------------------------------------
# Development Tool PATHs
# -----------------------------------------------------------------------------

# pnpm — $PNPM_HOME/bin: global package shims; $PNPM_HOME: pnpm runtime shims (standalone installer)
if [[ "$OSTYPE" == darwin* ]]; then
  export PNPM_HOME="$HOME/Library/pnpm"
else
  export PNPM_HOME="$HOME/.local/share/pnpm"
fi
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PNPM_HOME:$PATH" ;;
esac

# User binaries (uv-installed tools, custom scripts, mise itself) — must precede
# the mise activation below, which is where `command -v mise` finds the binary
# now that mise installs from https://mise.run instead of Homebrew. The cargo,
# bun and shim entries prepended after this one therefore outrank it.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# mise - manages node and other tools; --shims mode keeps tools resolvable in non-interactive shells (git hooks, GUI apps)
#
# The result is checked against PATH rather than against activate's output or
# status: activate prints nothing once the shims dir is already there, and a
# truncated mise binary also prints nothing while exiting 0. Only PATH tells
# those apart, and an unnoticed failure silently drops every pinned tool to its
# system version. stderr stays out of the capture because eval runs whatever it
# holds — one mise warning would otherwise execute as shell code in every shell.
if command -v mise >/dev/null; then
  _mise_shims=$(mise activate zsh --shims 2>/dev/null) && eval "$_mise_shims"
  if [[ ":$PATH:" != *":$HOME/.local/share/mise/shims:"* ]]; then
    print -u2 "zshenv: mise did not activate, tools resolve to system versions. Diagnose with: mise activate zsh --shims"
  fi
  unset _mise_shims
fi

# Cargo/Rust binaries
case ":$PATH:" in
  *":$HOME/.cargo/bin:"*) ;;
  *) export PATH="$HOME/.cargo/bin:$PATH" ;;
esac

# Bun
export BUN_INSTALL="$HOME/.bun"
case ":$PATH:" in
  *":$BUN_INSTALL/bin:"*) ;;
  *) export PATH="$BUN_INSTALL/bin:$PATH" ;;
esac

# -----------------------------------------------------------------------------
# Android SDK
# -----------------------------------------------------------------------------
if [[ -d "$HOME/Library/Android/sdk" ]]; then
  export ANDROID_HOME=$HOME/Library/Android/sdk
  case ":$PATH:" in
    *":$ANDROID_HOME/cmdline-tools/10.0/bin:"*) ;;
    *) export PATH="$PATH:$ANDROID_HOME/cmdline-tools/10.0/bin" ;;
  esac
fi

# -----------------------------------------------------------------------------
# Core Environment Variables
# -----------------------------------------------------------------------------
export LC_ALL="en_US.UTF-8"
export EDITOR=nvim

# Without a terminal, core.editor's nvim blocks forever on a bare `git commit`,
# `rebase -i`, or `tag -a` — a hang that reports nothing. `false` turns that into
# an immediate "problem with the editor" error the caller can read and fix by
# passing -m or --no-edit. GIT_SEQUENCE_EDITOR covers interactive rebase's todo
# list, which git reads through a separate setting.
if [[ ! -t 1 ]]; then
  export GIT_EDITOR="${GIT_EDITOR-false}"
  export GIT_SEQUENCE_EDITOR="${GIT_SEQUENCE_EDITOR-false}"
fi
# Exported only when the file is there: rg prints "failed to read the file
# specified in RIPGREP_CONFIG_PATH" on every invocation otherwise, which lands
# in the output of anything that shells out to rg.
[[ -f "$HOME/.rgrc" ]] && export RIPGREP_CONFIG_PATH="$HOME/.rgrc"
