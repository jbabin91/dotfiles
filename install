#!/usr/bin/env bash

set -e

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Refused rather than ignored, so --help or --dry-run cannot deploy for real.
if [ "$#" -gt 0 ]; then
  echo "  ./install takes no arguments; it bootstraps chezmoi and applies ${BASEDIR} into \$HOME" >&2
  exit 2
fi

# Everything below deploys into $HOME; without it chezmoi reads as a broken binary
# and the installer tries to write /.local.
if [ -z "${HOME}" ] || [ ! -d "${HOME}" ]; then
  echo "  \$HOME is unset or not a directory; ./install deploys into \$HOME and cannot continue" >&2
  exit 1
fi

# Runs the binary rather than trusting the file: a truncated install leaves a
# zero-byte file that is still executable and still exits 0 on every call.
usable() { [ -s "$1" ] && "$1" --version >/dev/null 2>&1; }

CHEZMOI="$(command -v chezmoi || true)"
if [ -n "${CHEZMOI}" ] && ! usable "${CHEZMOI}"; then
  echo "  chezmoi: ${CHEZMOI} is on PATH but will not run; installing a fresh copy" >&2
  CHEZMOI=""
fi
if [ -z "${CHEZMOI}" ] && [ -e "${HOME}/.local/bin/chezmoi" ]; then
  if usable "${HOME}/.local/bin/chezmoi"; then
    CHEZMOI="${HOME}/.local/bin/chezmoi"
  else
    echo "  chezmoi: ${HOME}/.local/bin/chezmoi exists but will not run; reinstalling over it" >&2
  fi
fi
# chezmoi is not in the Brewfile, so it installs itself. Fetched to a file
# because a pipeline reports sh's status, and sh on a truncated download exits 0.
# Its -b defaults to ./bin.
if [ -z "${CHEZMOI}" ]; then
  installer="$(mktemp)" ||
    { echo "  chezmoi: mktemp failed, cannot stage the installer" >&2; exit 1; }
  trap 'rm -f "${installer}"' EXIT
  curl -fsSL https://get.chezmoi.io -o "${installer}" ||
    { s=$?; echo "  chezmoi: could not download https://get.chezmoi.io (curl exited ${s}); nothing was linked or deployed" >&2; exit "${s}"; }
  head -n1 "${installer}" | grep -q '^#!' ||
    { echo "  chezmoi: https://get.chezmoi.io returned $(wc -c <"${installer}" | tr -d " ") bytes that are not a script" >&2; exit 1; }
  sh "${installer}" -b "${HOME}/.local/bin" ||
    { s=$?; echo "  chezmoi: installer exited ${s} (over 128 means killed by signal); nothing was linked or deployed" >&2; exit "${s}"; }
  CHEZMOI="${HOME}/.local/bin/chezmoi"
  usable "${CHEZMOI}" ||
    { echo "  chezmoi: installer exited 0 but left no working binary at ${CHEZMOI}" >&2; exit 1; }
fi

# chezmoi reads .chezmoiroot from the repo itself and rejects an empty or
# unreadable one, but without the file it exits 0 having applied the whole repo
# into $HOME, and no later check undoes that.
SOURCE="${BASEDIR}"
if [ ! -f "${SOURCE}/.chezmoiroot" ]; then
  echo "  chezmoi: ${SOURCE}/.chezmoiroot is missing or not a regular file; refusing to apply the repo root into ${HOME}" >&2
  exit 1
fi

# init writes sourceDir into ~/.config/chezmoi/chezmoi.toml from the template,
# which resolves it rather than hardcoding a path, so the repo can live anywhere.
# --destination is pinned because init's apply stage otherwise honours a destDir
# already in that file, sending the whole apply elsewhere while every check passes.
"${CHEZMOI}" init --source "${SOURCE}" --destination "${HOME}" --apply ||
  { s=$?; echo "  chezmoi init exited ${s} (over 128 means killed by signal); it applies as it goes, so ${HOME} may hold some, all or none of its files; its mise, brew and tmux-plugin scripts run last, and a failing one is named above and stops the ones after it -- run ${CHEZMOI} status --source ${SOURCE} to see what landed" >&2; exit "${s}"; }

# Whole-tree verify first, so drift is reported as drift. It passes vacuously on
# an empty source, which the targeted verify below then catches: once everything
# managed matches disk, .zshrc can only fail for not being managed at all. An
# unstable template would fail both on every correct run. Scripts are excluded:
# one whose rendered key changed during the apply (brew installing tpack) reads
# as pending, which is not drift, and a failing one already failed the apply.
"${CHEZMOI}" verify --exclude=scripts --source "${SOURCE}" --destination "${HOME}" ||
  { s=$?; echo "  chezmoi applied, but chezmoi verify exited ${s} (over 128 means killed by signal); if chezmoi printed an error above that is the cause, otherwise ${HOME} does not match ${SOURCE} -- run ${CHEZMOI} status --source ${SOURCE}" >&2; exit "${s}"; }
"${CHEZMOI}" verify --source "${SOURCE}" --destination "${HOME}" "${HOME}/.zshrc" ||
  { s=$?; echo "  chezmoi applied, but chezmoi verify of .zshrc exited ${s} (over 128 means killed by signal); if chezmoi printed an error above that is the cause, otherwise chezmoi manages no .zshrc from ${SOURCE} -- check .chezmoiroot names the source directory, and that its dot_zshrc exists and is not excluded by .chezmoiignore" >&2; exit "${s}"; }
